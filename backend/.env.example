# ================================
# SERVER
# ================================
PORT=5000
TZ=Asia/Tashkent
JWT_SECRET=your_super_secret_here

# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ================================
# GEONAMES
# ================================
GEONAMES_USERNAME=your_geonames_username

# ================================
# TELEGRAM — MAIN BOT (travella.uz)
# ================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=Travella2025
# Optional official Telegram secret_token header for setWebhook?useHeader=1
TELEGRAM_WEBHOOK_TOKEN=

# ================================
# TELEGRAM — CLIENT BOT
# ================================
TELEGRAM_CLIENT_BOT_TOKEN=your_client_bot_token
AI_PUBLISH_TELEGRAM_CHAT_ID=

# ================================
# TELEGRAM — ADMINS
# ================================
TELEGRAM_ADMIN_CHAT_IDS=123456789
TELEGRAM_MANAGER_CHAT_ID=123456789

# ================================
# SITE
# ================================
SITE_PUBLIC_URL=https://travella.uz
TG_IMAGE_BASE=https://your-backend-domain

# ================================
# PAYME (если используешь)
# ================================
PAYME_MERCHANT_LOGIN=your_login
PAYME_MERCHANT_KEY=your_key

# ================================
# DONAS DOSAS
# ================================
DONAS_PUBLIC_KEY=your_public_key

# ================================
# CLOUDINARY — HOTEL REVIEWS MEDIA
# ================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_HOTEL_REVIEWS_FOLDER=travella/hotel-reviews

# ================================
# TRAVELLA AI PLATFORM
# ================================
# Keep false on production until manual approval and cost controls are verified.
AI_VIDEO_ENABLED=false
AI_JOB_STORE_DB_ENABLED=true
AI_VIDEO_FORMAT=9:16
AI_VIDEO_RESOLUTION=1080p
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_WEBHOOK_SECRET=
DISABLE_AI_HEYGEN_POLLER=false
AI_HEYGEN_POLLER_INTERVAL_MS=120000
AI_HEYGEN_POLLER_BATCH_LIMIT=20

# Optional: persistent MP4 storage for generated AI videos.
# If R2 is configured, completed HeyGen videos are copied there automatically.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
