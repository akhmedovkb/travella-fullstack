{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "india.travella.uz"
        }
      ],
      "headers": {
        "Location": "https://travella.uz/ru/india/inside"
      },
      "status": 308
    },
    {
      "src": "^/api/seo(?:\\.js)?$",
      "dest": "/api/seo.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js?path=$1",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/",
      "dest": "/api/seo.js?path=/"
    },
    {
      "src": "/index.html",
      "headers": {
        "Location": "/ru"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/seo.js?path=/$1"
    }
  ],
  "functions": {
    "api/seo.js": {
      "includeFiles": "dist/index.html",
      "maxDuration": 30
    }
  }
}
